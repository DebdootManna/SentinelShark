<Window x:Class="SentinelSharkDotNet.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SentinelSharkDotNet.UI"
        mc:Ignorable="d"
        Title="SentinelShark - Network Intrusion Detection &amp; Analysis System" 
        Height="900" Width="1400" 
        MinWidth="1200" MinHeight="700"
        Background="{StaticResource BaseBackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="3*" />
            <RowDefinition Height="5" />
            <RowDefinition Height="260" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- 1. Title Bar -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBackgroundBrush}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Data="M 12 0 L 24 12 L 12 24 L 0 12 Z M 12 4 L 20 12 L 12 20 L 4 12 Z" Fill="{StaticResource AccentCyanBrush}" Width="24" Height="24" Stretch="Uniform" Margin="0,0,10,0" />
                    <TextBlock Text="SentinelShark" Foreground="{StaticResource AccentCyanBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="v1.0.0 — Network Intrusion Detection &amp; Analysis" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusIndicatorText" Text="● IDLE" Foreground="{StaticResource TextMutedBrush}" FontFamily="{StaticResource MonoFont}" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Toolbar -->
        <Border Grid.Row="1" Background="{StaticResource CardBackgroundBrush}" Padding="8,16">
            <DockPanel LastChildFill="True">
                <ComboBox x:Name="InterfaceCombo" DockPanel.Dock="Left" Width="160" Margin="0,0,8,0" SelectionChanged="InterfaceCombo_SelectionChanged" />
                
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="StartBtn" Content="Start Capture" Style="{StaticResource StartButtonStyle}" Margin="8,0,0,0" Click="StartBtn_Click"/>
                    <Button x:Name="StopBtn" Content="■ Stop" Style="{StaticResource StopButtonStyle}" Margin="8,0,0,0" Click="StopBtn_Click"/>
                    <Button x:Name="ClearBtn" Content="Clear" Style="{StaticResource ClearButtonStyle}" Margin="8,0,0,0" Click="ClearBtn_Click"/>
                    <Button x:Name="SaveBtn" Content="💾 Save" Margin="8,0,0,0" Click="SaveBtn_Click"/>
                    <ToggleButton x:Name="MockToggle" Content="⚡ Mock OFF" Style="{StaticResource MockToggleStyle}" Margin="8,0,0,0" Checked="MockToggle_Checked" Unchecked="MockToggle_Unchecked"/>
                    <Button x:Name="ApiKeysBtn" Content="🔑 API Keys" Margin="8,0,0,0" Click="ApiKeysBtn_Click"/>
                </StackPanel>
                
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="🔍" VerticalAlignment="Center" Margin="8,0,4,0" Foreground="{StaticResource TextMutedBrush}"/>
                    <TextBox x:Name="BpfFilterBox" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" TextChanged="BpfFilterBox_TextChanged">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 3. Main Content Area Top -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="PacketGrid" Grid.Column="0" AutoGenerateColumns="False" SelectionMode="Single" SelectionUnit="FullRow" CanUserAddRows="False" CanUserDeleteRows="False" HeadersVisibility="Column" SelectionChanged="PacketGrid_SelectionChanged" Background="{StaticResource PanelBackgroundBrush}">
                <DataGrid.Resources>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="Transparent" BorderThickness="0" Padding="4,2" SnapsToDevicePixels="True">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridRow">
                                    <Border x:Name="RowBorder" Background="{TemplateBinding Background}" BorderThickness="0" Padding="0,2" Margin="0,1">
                                        <DataGridCellsPresenter ItemsControl.ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- Critical Threat (>= 90): Dark Crimson Red -->
                                        <DataTrigger Binding="{Binding IsCriticalThreat}" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#D97F1D1D"/>
                                            <Setter Property="Foreground" Value="#FFFECACA"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>

                                        <!-- High Risk (>= 50): Dark Orange / Amber -->
                                        <DataTrigger Binding="{Binding IsHighRiskThreat}" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#D978350F"/>
                                            <Setter Property="Foreground" Value="#FFFEF3C7"/>
                                        </DataTrigger>

                                        <!-- Low Risk (> 0): Dark Yellow -->
                                        <DataTrigger Binding="{Binding IsLowRiskThreat}" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#D9713F12"/>
                                            <Setter Property="Foreground" Value="#FFFEF08A"/>
                                        </DataTrigger>

                                        <!-- Safe Public IP (score == 0 & Public Resolved): Dark Emerald Green -->
                                        <DataTrigger Binding="{Binding IsSafePublicIp}" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#B3064E3B"/>
                                            <Setter Property="Foreground" Value="#FFD1FAE5"/>
                                        </DataTrigger>

                                        <!-- Selected Row Override -->
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="RowBorder" Property="Background" Value="#FF1D4ED8"/>
                                            <Setter Property="Foreground" Value="#FFF8FAFC"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="NO." Binding="{Binding No}" Width="50">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="DESTINATION" Binding="{Binding Destination}" Width="130">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="PROTOCOL" Binding="{Binding Protocol}" Width="75">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="LENGTH" Binding="{Binding Length}" Width="55">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="INFO" Binding="{Binding Info}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="THREAT SCORE" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border x:Name="BadgeBorder" CornerRadius="10" Padding="8,2" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1F22C55E" BorderBrush="#4022C55E" BorderThickness="1">
                                    <TextBlock x:Name="BadgeText" Text="{Binding ThreatScoreDisplay}" Foreground="#FF4ADE80" FontSize="11" FontFamily="{StaticResource MonoFont}" FontWeight="Medium"/>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLowRiskThreat}" Value="True">
                                        <Setter TargetName="BadgeBorder" Property="Background" Value="#1FEAB308"/>
                                        <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#40EAB308"/>
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="#FFFACC15"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsHighRiskThreat}" Value="True">
                                        <Setter TargetName="BadgeBorder" Property="Background" Value="#1FF59E0B"/>
                                        <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#40F59E0B"/>
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="#FFFBBF24"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsCriticalThreat}" Value="True">
                                        <Setter TargetName="BadgeBorder" Property="Background" Value="#1FEF4444"/>
                                        <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="#40EF4444"/>
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="#FFF87171"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

            <!-- Sidebar -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="8">
                    <!-- Stat Cards 2x2 Grid -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Row="0" Grid.Column="0" Margin="4" Padding="8" Background="{StaticResource CardBackgroundBrush}" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="TOTAL PACKETS" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                <TextBlock x:Name="TotalPacketsText" Text="0" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Row="0" Grid.Column="1" Margin="4" Padding="8" Background="{StaticResource CardBackgroundBrush}" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="DATA TRAFFIC" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                <TextBlock x:Name="TotalBytesText" Text="0 B" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Row="1" Grid.Column="0" Margin="4" Padding="8" Background="{StaticResource CardBackgroundBrush}" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="SAFE PACKETS" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                <TextBlock x:Name="SafePacketsText" Text="0" Foreground="{StaticResource SafeGreenBrush}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Row="1" Grid.Column="1" Margin="4" Padding="8" Background="{StaticResource CardBackgroundBrush}" CornerRadius="4">
                            <StackPanel>
                                <TextBlock Text="THREATS DETECTED" Foreground="{StaticResource TextMutedBrush}" FontSize="10"/>
                                <TextBlock x:Name="ThreatsDetectedText" Text="0" Foreground="{StaticResource CriticalRedBrush}" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Protocol Breakdown -->
                    <Border Margin="4,8,4,4" Padding="8" Background="{StaticResource CardBackgroundBrush}" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="PROTOCOL BREAKDOWN" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="ProtocolBreakdownList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <ProgressBar Grid.Column="1" Value="{Binding Percentage, Mode=OneWay}" Maximum="100" Height="6" Margin="6,0" BorderThickness="0" Foreground="{StaticResource AccentBlueBrush}" Background="{StaticResource InputBackgroundBrush}"/>
                                            <TextBlock Grid.Column="2" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" FontFamily="{StaticResource MonoFont}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0">
                                                <Run Text="{Binding DisplayPercentage, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Threat Intel Queue -->
                    <Border Margin="4" Padding="8" Background="{StaticResource CardBackgroundBrush}" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="THREAT INTEL API QUEUE" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,8"/>
                            <Grid Margin="0,2">
                                <TextBlock Text="VirusTotal" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="VtApiStatusText" Text="Key Missing" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="AbuseIPDB" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="AbuseApiStatusText" Text="Key Missing" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="Shodan" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="ShodanApiStatusText" Text="Key Missing" Foreground="{StaticResource TextMutedBrush}" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,2">
                                <TextBlock Text="IPinfo" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                                <TextBlock x:Name="IpInfoApiStatusText" Text="Free Tier Active" Foreground="{StaticResource SafeGreenBrush}" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <TextBlock Text="Queue Processing" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                                <TextBlock x:Name="QueueStatusText" Text="Idle" Foreground="{StaticResource AccentCyanBrush}" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    
                    <!-- Selected Packet Summary -->
                    <Border Margin="4" Padding="8" Background="{StaticResource CardBackgroundBrush}" CornerRadius="4">
                        <StackPanel>
                            <TextBlock Text="SELECTED PACKET" Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,0,0,8"/>
                            <TextBlock x:Name="SelectedPacketSummaryText" Text="None selected" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <GridSplitter Grid.Row="3" Height="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>

        <!-- 4. Main Content Area Bottom (Details) -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Tree View -->
            <Border Grid.Column="0" Background="{StaticResource PanelBackgroundBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBackgroundBrush}" Padding="8,4">
                        <Grid>
                            <TextBlock Text="Packet Details (Dissection)" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Expand All" Margin="0,0,4,0" FontSize="10" Padding="4,2"/>
                                <Button Content="Collapse All" FontSize="10" Padding="4,2"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TreeView x:Name="PacketDetailTree" Background="Transparent" BorderThickness="0" Margin="4"/>
                </DockPanel>
            </Border>
            
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource BorderBrush}"/>
            
            <!-- Hex Viewer -->
            <Border Grid.Column="2" Background="{StaticResource PanelBackgroundBrush}">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="{StaticResource HeaderBackgroundBrush}" Padding="8,4">
                        <Grid>
                            <TextBlock Text="Raw Packet Bytes" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <TextBlock x:Name="HexByteCountText" Text="0 bytes" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                    
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource HeaderBackgroundBrush}" Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="MD5:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBox x:Name="Md5Text" Grid.Column="1" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource MonoFont}"/>
                            
                            <TextBlock Grid.Column="2" Text="SHA256:" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,4,0"/>
                            <TextBox x:Name="Sha256Text" Grid.Column="3" IsReadOnly="True" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondaryBrush}" FontFamily="{StaticResource MonoFont}"/>
                        </Grid>
                    </Border>
                    
                    <RichTextBox x:Name="HexViewer" IsReadOnly="True" Background="{StaticResource HexViewBackgroundBrush}" BorderThickness="0" FontFamily="{StaticResource MonoFont}" FontSize="12" Padding="8" VerticalScrollBarVisibility="Auto">
                        <FlowDocument PageWidth="800"/>
                    </RichTextBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 5. Status Bar -->
        <Border Grid.Row="5" Background="{StaticResource StatusBarBackgroundBrush}">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="CaptureStatusLabel" Text="○ Capture stopped" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock x:Name="FilterIndicator" Text="No Filter" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock x:Name="PacketCountLabel" Text="Packets: 0" Foreground="{StaticResource TextDimBrush}" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock x:Name="ByteCountLabel" Text="Bytes: 0" Foreground="{StaticResource TextDimBrush}" FontSize="11"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="TSharkStatusDot" Width="8" Height="8" Fill="{StaticResource WarningAmberBrush}" Margin="0,0,4,0"/>
                    <TextBlock x:Name="TSharkStatusText" Text="Checking TShark..." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock Text="SentinelShark v1.0.0" Foreground="{StaticResource TextMutedBrush}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
