# SentinelShark Environment Configuration Template
# Copy this file to .env on your local machine.
# All local machine configurations, preferences, and secrets are saved here.

ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=
IPINFO_API_KEY=
DEFAULT_INTERFACE=auto
MOCK_MODE=false
AUTO_SCROLL=true
CACHE_TTL_HOURS=24
MAX_REQUESTS_PER_MINUTE=30
TSHARK_PATH=
